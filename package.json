{
  "name": "midas-platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "shared/types",
    "shared/tokens"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@midas/web",
    "build:web": "npm run build --workspace=@midas/web",
    "start:web": "npm run start --workspace=@midas/web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
