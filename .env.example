# ============================================================
# Midas Platform — Environment Configuration
# Copy to .env and fill in your API keys:  cp .env.example .env
# ============================================================

# ── LLM Configuration ───────────────────────────────────────
# Used by the debate agent (Kaizen) for conversational AI
#
# MiniMax (primary — OpenAI-compatible API)
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_API_BASE=https://api.minimaxi.com/v1
# DEFAULT_LLM_MODEL=MiniMax-Text-01
#
# ZAI (fallback — OpenAI-compatible API)
# ZAI_API_KEY=your-zai-api-key-here
# ZAI_API_BASE=https://api.zai.chat/v1
#
# OpenAI (second fallback)
# OPENAI_API_KEY=sk-your-key-here
#
# Anthropic (last resort)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Data Sources ───────��────────────────────────────────────
# EODHD — primary market data (EOD bars, fundamentals, corporate actions)
# EODHD_API_KEY=your-eodhd-key-here

# Perplexity — news and market intelligence
# PERPLEXITY_API_KEY=pplx-your-key-here

# FRED — macroeconomic data (VIX, credit spreads, yield curve)
# No key required for limited use; set for higher rate limits
# FRED_API_KEY=your-fred-key-here

# ── IBKR Integration ───────────────────────────────────────
# Interactive Brokers Client Portal Web API
# IBKR_CLIENT_ID=your-client-id
# IBKR_CLIENT_SECRET=your-client-secret
# IBKR_REDIRECT_URI=http://localhost:3000/api/account/ibkr/callback
# IBKR_GATEWAY_URL=https://localhost:5000  # Local CP Gateway fallback
# IBKR_TOKEN_ENCRYPTION_KEY=change-this-to-a-random-32-byte-hex-string

# ── Database ────────────────────────────────────────────────
# PostgreSQL 16 + TimescaleDB + pgvector
# DATABASE_URL=postgresql://midas:password@localhost:5432/midas
# REDIS_URL=redis://localhost:6379/0

# DataFlow pool configuration
# DATAFLOW_MAX_CONNECTIONS=10

# ── Authentication ──────────────────────────────────────────
# JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# ── Application ─────────────────────────────────────────────
# MIDAS_ENV=development
# DEBUG=true
# LOG_LEVEL=INFO

# ── External Services ───��──────────────────────────────────
# S3 for audit trail export (versioned bucket)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AUDIT_S3_BUCKET=midas-audit-trail

# Push notifications (Expo)
# EXPO_ACCESS_TOKEN=your-expo-token

# Email (SendGrid or SES)
# SENDGRID_API_KEY=your-sendgrid-key
